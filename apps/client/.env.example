# PerfectPic Client Environment Variables
# Backend API URL (default: http://localhost:4000 in dev or auto-detected in browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin Portal URL (default: http://localhost:3001 in dev or auto-detected in browser)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Razorpay Key ID (optional on client, backend automatically passes RAZORPAY_KEY_ID to checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_here
