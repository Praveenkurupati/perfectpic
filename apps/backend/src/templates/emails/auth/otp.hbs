<!-- Schema.org JSON-LD Email Markup for Google / Gmail One-Click Copy & Verification -->
<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "EmailMessage",
  "description": "One-time login code",
  "action": {
    "@type": "VerifyAction",
    "name": "Verify Code",
    "result": {
      "@type": "CodeAction",
      "code": "{{#if verificationCode}}{{verificationCode}}{{else}}{{otpCode}}{{/if}}"
    }
  }
}
</script>

<div style="text-align: left;">
  <!-- Main Title -->
  <h1 style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 22px; font-weight: 700; color: #111111; margin: 0 0 16px 0; line-height: 1.3;">
    {{#if (eq purpose "signup")}}
      Verify your email for PerfectPic
    {{else if (eq purpose "password_reset")}}
      Password reset code from PerfectPic
    {{else if (eq purpose "order_verification")}}
      Confirm your order with PerfectPic
    {{else}}
      One-time verification code
    {{/if}}
  </h1>

  <p style="font-size: 15px; color: #333333; margin: 0 0 16px 0; line-height: 1.6;">
    Hello{{#if name}} <strong>{{name}}</strong>{{else}} Valued Collector{{/if}},
  </p>

  <!-- Body Paragraph with Bold OTP -->
  <p style="font-size: 15px; color: #333333; margin: 0 0 20px 0; line-height: 1.7;">
    Your one-time verification code is <strong style="font-size: 22px; font-weight: 800; color: #000000; letter-spacing: 2px;">{{otpCode}}</strong>. Valid for <strong>{{#if expiryMinutes}}{{expiryMinutes}}{{else}}10{{/if}} minutes</strong>. Never share this code with anyone.
  </p>

  <!-- Security Information -->
  <div style="background-color: #f9f9f8; border-left: 3px solid #b89355; padding: 12px 16px; margin: 24px 0 20px 0; border-radius: 0 4px 4px 0;">
    <p style="font-size: 12px; color: #555555; margin: 0; line-height: 1.5;">
      🔒 <strong>Security Tip:</strong> PerfectPic will never contact you asking for your verification code. If you did not request this code, no action is needed and your account remains secure.
    </p>
  </div>

  <p style="font-size: 14px; color: #555555; margin: 24px 0 0 0; line-height: 1.5;">
    Thank you for choosing <strong>PerfectPic</strong>.
  </p>
</div>
