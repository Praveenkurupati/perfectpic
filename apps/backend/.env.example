PORT=4000
# Database Connection:
# Local MongoDB: mongodb://localhost:27017/perfectpic
# MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/perfectpic?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/perfectpic
DATABASE_URL=postgres://user:password@localhost:5432/perfectpic

# Redis Cache Connection:
# Local Redis: redis://localhost:6379
# Cloud Redis (Upstash / AWS ElastiCache / Redis Cloud): redis://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

JWT_SECRET=super_secret_jwt_key_here
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_BUCKET=perfectpic-assets-2026
AWS_REGION=ap-south-1
RAZORPAY_KEY_ID=rzp_test_12345
RAZORPAY_KEY_SECRET=razorpay_secret
SMS_API_KEY=mock_sms_key
APP_DOMAIN=perfectpic.in
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Email Configuration (Zoho Mail SMTP)
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_USER=noreply@perfectpic.in
SMTP_PASS=your_zoho_smtp_password
SMTP_SECURE=true
SMTP_FROM="PerfectPic <noreply@perfectpic.in>"

# WhatsApp Business API (Kapso.ai Meta Cloud API v24.0)
# Dashboard: https://app.kapso.ai/projects/3aa7c2d1-0d9e-4f89-9c9d-56e5e15231ad/api_keys
# Sandbox / Live Phone Numbers: https://app.kapso.ai/projects/3aa7c2d1-0d9e-4f89-9c9d-56e5e15231ad/phone_numbers
KAPSO_API_KEY=your_kapso_api_key_here
KAPSO_PHONE_NUMBER_ID=your_phone_number_id_here
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0
WHATSAPP_ENABLED=true
WHATSAPP_SANDBOX_MODE=true
