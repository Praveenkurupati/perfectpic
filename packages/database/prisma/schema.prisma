generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Authentication ─────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  phone        String?   @unique
  email        String?   @unique
  name         String?
  avatarUrl    String?
  authProvider String    @default("otp") // otp, google, apple
  role         String    @default("customer") // customer, admin, super-admin
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses      Address[]
  projects       Project[]
  orders         Order[]
  supportTickets SupportTicket[]

  @@map("users")
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  fullName       String
  phone          String
  alternatePhone String?
  pinCode        String
  city           String
  state          String
  addressLine1   String
  addressLine2   String?
  landmark       String?
  type           String   @default("home") // home, work, other
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ─── Projects (Book Designs) ────────────────────────────────────────────────

model Project {
  id             String   @id @default(uuid())
  userId         String?
  guestSessionId String?
  title          String   @default("My Photobook")
  subtitle       String?
  spineText      String?
  category       String?
  bookSize       String   // 8.25x8.25, 10x10, A4, A5
  coverType      String   // hardcover-laminar, softcover-layflat
  theme          String   // minimal-scandinavian, classic-travel, etc.
  coverColor     String   // pastel-pink, sage-green, etc.
  packaging      String   @default("standard") // standard, keepsake-box
  pageCount      Int      @default(20)
  status         String   @default("draft") // draft, processing, editing, preview, approved, ordered
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  photos     Photo[]
  pages      Page[]
  orderItems OrderItem[]

  @@index([userId])
  @@index([guestSessionId])
  @@map("projects")
}

model Photo {
  id            String   @id @default(uuid())
  projectId     String
  originalUrl   String
  thumbnailUrl  String?
  compressedUrl String?
  filename      String
  mimeType      String
  width         Int
  height        Int
  fileSize      Int
  dpi           Int?
  isBlurry      Boolean  @default(false)
  isLowRes      Boolean  @default(false)
  isDuplicate   Boolean  @default(false)
  capturedAt    DateTime?
  orientation   Int?
  latitude      Float?
  longitude     Float?
  camera        String?
  usageCount    Int      @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("photos")
}

model Page {
  id              String @id @default(uuid())
  projectId       String
  pageNumber      Int
  layoutType      String // full-bleed, 2-photo-split, etc.
  backgroundColor String @default("#FFFFFF")
  canvasJson      String? @db.Text // Fabric.js serialized JSON

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, pageNumber])
  @@index([projectId])
  @@map("pages")
}

// ─── Orders & Payments ──────────────────────────────────────────────────────

model Order {
  id                    String    @id @default(uuid())
  orderNumber           String    @unique // WB-XXXX
  userId                String
  subtotal              Float
  discount              Float     @default(0)
  promoCode             String?
  shippingCost          Float     @default(0)
  totalAmount           Float
  depositAmount         Float?
  balanceDue            Float?
  paymentMethod         String    // upi, credit-card, etc.
  paymentStatus         String    @default("pending") // pending, deposit-paid, fully-paid, refunded, failed
  orderStatus           String    @default("payment-pending")
  deliveryType          String    @default("standard") // standard, express
  isGift                Boolean   @default(false)
  giftMessage           String?
  addressId             String?
  trackingId            String?
  trackingUrl           String?
  courierPartner        String?
  estimatedDispatchDate DateTime?
  estimatedDeliveryDate DateTime?
  printPdfUrl           String?
  razorpayOrderId       String?
  razorpayPaymentId     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user    User       @relation(fields: [userId], references: [id])
  address Address?   @relation(fields: [addressId], references: [id])
  items   OrderItem[]

  @@index([userId])
  @@index([orderStatus])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  projectId       String
  bookSize        String
  coverType       String
  theme           String
  pageCount       Int
  basePrice       Float
  extraPagesPrice Float
  packagingPrice  Float
  quantity        Int    @default(1)
  subtotal        Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id])

  @@map("order_items")
}

// ─── Promo Codes ────────────────────────────────────────────────────────────

model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    // flat, percentage
  discountValue Float
  minOrderAmount Float    @default(0)
  maxUses       Int?
  currentUses   Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@map("promo_codes")
}

// ─── Support Tickets ────────────────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  orderId     String?
  type        String   // cancellation, address-change, damage-report, reprint-request, general-inquiry
  status      String   @default("open") // open, in-progress, resolved, closed
  subject     String
  description String   @db.Text
  attachments String[] // URLs
  response    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

// ─── OTP Verification ───────────────────────────────────────────────────────

model OtpVerification {
  id         String   @id @default(uuid())
  identifier String   // phone or email
  otp        String
  type       String   @default("sms") // sms, whatsapp, email
  isUsed     Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, otp])
  @@map("otp_verifications")
}
